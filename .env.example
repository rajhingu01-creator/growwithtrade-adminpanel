# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas.
MONGODB_URI="mongodb+srv://growwithtrade04_db_user:<password>@growwithtrade.rftrxsq.mongodb.net/trading-demo?appName=Growwithtrade"

# JWT_SECRET: Secret for signing JWT tokens.
JWT_SECRET="3613d551578ca0e2ee1d7bc224693f22481eea682c3abb84a7cefe2167a581406baccce3ef54231c7c7eb36a2e526f9be02d47a14b6244426b26356bfe7c0543"

# NOWPAYMENTS_API_KEY: For crypto automatic deposits.
NOWPAYMENTS_API_KEY=

# UROPAY_API_KEY: For UPI/GPay/PhonePe deposits.
UROPAY_API_KEY=
# UROPAY_SECRET: Optional secret used to build Authorization hash when required by UroPay account.
UROPAY_SECRET=
